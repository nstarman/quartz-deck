---
source: tests/roundtrip.rs
expression: "Deck::parse(text).outline()"
---
slide_level=2 size=1050x700 front_matter=true title_slide=true nl="\n"
@1 introduction (auto) Heading L2 title=Some("Introduction")
    introduction/0 Para "Welcome to the talk."
@2 results (auto) Heading L2 title=Some("Results")
    results/0 List "- First result"
@3 conclusion (auto) Heading L2 title=Some("Conclusion")
    conclusion/0 Para "Thanks!"
