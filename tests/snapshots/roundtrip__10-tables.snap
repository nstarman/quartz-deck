---
source: tests/roundtrip.rs
expression: "Deck::parse(text).outline()"
---
slide_level=2 size=1050x700 front_matter=true title_slide=true nl="\n"
@1 pipe-table (auto) Heading L2 title=Some("Pipe table")
    pipe-table/0 Table "| Model | Score |"
    pipe-table/1 Para ": Results {#tbl-results}"
@2 grid-table (auto) Heading L2 title=Some("Grid table")
    grid-table/0 Table "+---------+---------+"
