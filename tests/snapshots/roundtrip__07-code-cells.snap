slide_level=2 size=1050x700 front_matter=true title_slide=true nl="\n"
@1 a-python-cell (auto) Heading L2 title=Some("A Python cell")
    a-python-cell/0 Cell "```{python}"
@2 an-r-cell (auto) Heading L2 title=Some("An R cell")
    an-r-cell/0 Cell "```{r}"
@3 plain-code (auto) Heading L2 title=Some("Plain code")
    plain-code/0 Code "~~~bash"
    plain-code/1 Code "````markdown"
