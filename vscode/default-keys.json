{
  "source": "https://code.visualstudio.com/docs/reference/default-keybindings (macOS, read 2026-11-05)",
  "note": "VS Code's default bindings that act while a webview (the slide panel) has focus: workbench commands, not editor.* ones scoped to a text editor. Left out on purpose: the edit keys VS Code hands to a focused webview (Mod+Z, Mod+Shift+Z, Mod+X, Mod+C, Mod+V, Mod+A). Mod+K stands for every Mod+K chord. Keys use actions.json's notation (Mod = ⌘).",
  "keys": {
    "Mod+P": "workbench.action.quickOpen",
    "Mod+Shift+P": "workbench.action.showCommands",
    "F1": "workbench.action.showCommands",
    "Mod+T": "workbench.action.showAllSymbols",
    "Mod+Shift+O": "workbench.action.gotoSymbol",
    "Ctrl+G": "workbench.action.gotoLine",
    "Mod+Shift+M": "workbench.actions.view.problems",
    "Ctrl+Tab": "workbench.action.quickOpenPreviousRecentlyUsedEditorInGroup",
    "Ctrl+-": "workbench.action.navigateBack",
    "Ctrl+Shift+-": "workbench.action.navigateForward",
    "Mod+Shift+N": "workbench.action.newWindow",
    "Mod+Shift+W": "workbench.action.closeWindow",
    "Mod+W": "workbench.action.closeActiveEditor",
    "Mod+K": "chord prefix (Mod+K …)",
    "Mod+\\": "workbench.action.splitEditor",
    "Mod+1": "workbench.action.focusFirstEditorGroup",
    "Mod+2": "workbench.action.focusSecondEditorGroup",
    "Mod+3": "workbench.action.focusThirdEditorGroup",
    "Ctrl+Mod+ArrowRight": "workbench.action.moveEditorToNextGroup",
    "Ctrl+Mod+ArrowLeft": "workbench.action.moveEditorToPreviousGroup",
    "Mod+N": "workbench.action.files.newUntitledFile",
    "Mod+O": "workbench.action.files.openFile",
    "Mod+S": "workbench.action.files.save",
    "Alt+Mod+S": "saveAll",
    "Mod+Shift+S": "workbench.action.files.saveAs",
    "Mod+Shift+T": "workbench.action.reopenClosedEditor",
    "Ctrl+Mod+F": "workbench.action.toggleFullScreen",
    "Mod+=": "workbench.action.zoomIn",
    "Mod+-": "workbench.action.zoomOut",
    "Mod+B": "workbench.action.toggleSidebarVisibility",
    "Mod+Shift+E": "workbench.view.explorer",
    "Mod+Shift+F": "workbench.view.search",
    "Ctrl+Shift+G": "workbench.view.scm",
    "Mod+Shift+D": "workbench.view.debug",
    "Mod+Shift+X": "workbench.view.extensions",
    "Mod+Shift+U": "workbench.action.output.toggleOutput",
    "Ctrl+Q": "workbench.action.quickOpenView",
    "Mod+Shift+C": "workbench.action.terminal.openNativeConsole",
    "Ctrl+`": "workbench.action.terminal.toggleTerminal",
    "Mod+Shift+H": "workbench.action.replaceInFiles",
    "Mod+,": "workbench.action.openSettings",
    "Ctrl+Mod+I": "workbench.action.chat.open",
    "Mod+Shift+I": "workbench.action.chat.openagent",
    "Alt+Mod+Shift+L": "workbench.action.quickchat.toggle",
    "F5": "workbench.action.debug.start",
    "Ctrl+F5": "workbench.action.debug.run",
    "F6": "workbench.action.debug.pause",
    "Mod+Shift+B": "workbench.action.tasks.build"
  }
}
